
# Copy this file to .env in this directory. Replace the placeholder credentials.
APP_NAME=SereniLink
ENV=dev

# Create this PostgreSQL database first. URL-encode special characters in credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/serenilink

# Required: generate a random secret; the application reads JWT_SECRET, not SECRET_KEY.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# HF_API_KEY is required by settings; a valid token is needed for AI requests.
HF_API_KEY=replace-with-your-huggingface-token
HF_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=openai/gpt-oss-20b:groq

# Public frontend origin used in password reset emails (no trailing path).
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins. localhost and 127.0.0.1 are different origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP uses STARTTLS. Blank user/password disables email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serenilink.com
